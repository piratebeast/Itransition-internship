@page
@model UserManagement.Pages.Users.IndexModel
@using Humanizer
@using UserManagement.Models
@{
    ViewData["Title"] = "Users";
}

<h1 class="h4 mb-3">Users</h1>

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="post">
    <div class="toolbar d-flex flex-wrap gap-2 align-items-center border rounded p-2 mb-3">
        <button type="submit" asp-page-handler="Block"
                class="btn btn-outline-primary btn-sm selection-required"
                data-bs-toggle="tooltip" title="Block selected users">
            <i class="bi bi-lock"></i> Block
        </button>

        <button type="submit" asp-page-handler="Unblock"
                class="btn btn-outline-secondary btn-sm selection-required"
                data-bs-toggle="tooltip" title="Unblock selected users"
                aria-label="Unblock">
            <i class="bi bi-unlock"></i>
        </button>

        <button type="submit" asp-page-handler="Delete"
                class="btn btn-outline-danger btn-sm selection-required"
                data-bs-toggle="tooltip" title="Delete selected users"
                aria-label="Delete">
            <i class="bi bi-trash"></i>
        </button>

        <button type="submit" asp-page-handler="DeleteUnverified"
                class="btn btn-outline-warning btn-sm"
                data-bs-toggle="tooltip" title="Delete all unverified users"
                aria-label="Delete unverified">
            <i class="bi bi-person-x"></i>
        </button>
        <div class="ms-auto">
            <input type="search" id="filterInput" class="form-control form-control-sm"
                   style="width: 14rem;" placeholder="Filter" aria-label="Filter users" />
        </div>
    </div>
    
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col" style="width: 2.5rem;">
                        <input class="form-check-input" type="checkbox" id="selectAll"
                               aria-label="Select all users" />
                    </th>
                    <th scope="col">Name</th>
                    <th scope="col">Email</th>
                    <th scope="col">Status</th>
                    <th scope="col">Last seen</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr class="@(user.Status == UserStatus.Blocked ? "text-muted" : "")">
                        <td>
                            <input class="form-check-input row-select" type="checkbox"
                                   name="SelectedIds" value="@user.Id"
                                   aria-label="Select @user.Name" />
                        </td>
                        <td>
                            @if (user.Status == UserStatus.Blocked)
                            {
                                <s>@user.Name</s>
                            }
                            else
                            {
                                @user.Name
                            }
                        </td>
                        <td>@user.Email</td>
                        <td>@user.Status</td>
                        <td>
                            @if (user.LastLoginAt is null)
                            {
                                <span class="text-muted">Never</span>
                            }
                            else
                            {
                                <span title="@user.LastLoginAt.Value.ToString("u")">
                                    @user.LastLoginAt.Value.Humanize()
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="confirmLabel">Confirm action</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="confirmBody"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="confirmProceed">Proceed</button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            const selectAll = document.getElementById('selectAll');
            const rows = Array.from(document.querySelectorAll('.row-select'));
            const needSelection = Array.from(document.querySelectorAll('.selection-required'));
            const currentUserId = '@Model.CurrentUserId';

            function sync() {
                const checked = rows.filter(r => r.checked).length;
                needSelection.forEach(b => b.disabled = checked === 0);
                selectAll.checked = checked > 0 && checked === rows.length;
                selectAll.indeterminate = checked > 0 && checked < rows.length;
            }

            selectAll.addEventListener('change', () => {
                rows.forEach(r => r.checked = selectAll.checked);
                sync();
            });
            rows.forEach(r => r.addEventListener('change', sync));
            sync();

            const filterInput = document.getElementById('filterInput');
            const bodyRows = Array.from(document.querySelectorAll('tbody tr'));

            filterInput.addEventListener('input', () => {
                const term = filterInput.value.trim().toLowerCase();
                bodyRows.forEach(tr => {
                    const match = tr.textContent.toLowerCase().includes(term);
                    tr.hidden = !match;

                    if (!match) {
                        const cb = tr.querySelector('.row-select');
                        if (cb) cb.checked = false;
                    }
                });
                sync();
            });

            // Destructive actions get a confirmation step. Blocking is reversible,
            // so only deletes are intercepted.
            const modalEl = document.getElementById('confirmModal');
            const modal = new bootstrap.Modal(modalEl);
            const confirmBody = document.getElementById('confirmBody');
            const confirmProceed = document.getElementById('confirmProceed');
            let pendingButton = null;

            document.querySelectorAll('button[type="submit"]').forEach(btn => {
                const action = btn.getAttribute('formaction') || '';
                if (!action.includes('Delete')) return;

                btn.addEventListener('click', e => {
                    e.preventDefault();
                    pendingButton = btn;

                    const checkedRows = rows.filter(r => r.checked);
                    const selfChecked = checkedRows.some(r => r.value === currentUserId);

                    let message = action.includes('DeleteUnverified')
                        ? 'Delete all unverified users? This cannot be undone.'
                        : `Delete ${checkedRows.length} user(s)? This cannot be undone.`;

                    if (selfChecked) {
                        message += ' This includes your own account — you will be signed out.';
                    }

                    confirmBody.textContent = message;
                    modal.show();
                });
            });

            confirmProceed.addEventListener('click', () => {
                modal.hide();
                if (pendingButton) {
                    const form = pendingButton.form;
                    form.action = pendingButton.getAttribute('formaction');
                    form.submit();
                }
            });

            [...document.querySelectorAll('[data-bs-toggle="tooltip"]')]
                .forEach(el => new bootstrap.Tooltip(el));
        })();
    </script>
}